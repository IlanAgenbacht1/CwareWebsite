<?xml version="1.0" encoding="UTF-8"?>
<!--
  CWARE website: IIS 10 configuration for the static site.

  IIS prerequisites (the site returns HTTP 500.19 if a feature used below is missing):
  1. URL Rewrite module 2.1 (the <rewrite> section).
  2. Static Content Compression role service (Web Server > Performance). Dynamic Content
     Compression is only needed for doDynamicCompression; this site is all static files.
  3. HTTPS binding with a certificate that covers BOTH cware.co.za and www.cware.co.za
     (otherwise https://www.cware.co.za shows a certificate error before it can redirect).
     TLS must end on this IIS server. If a proxy or CDN ends TLS in front of it, {HTTPS}
     is always "off" here and the HTTPS rule must test {HTTP_X_FORWARDED_PROTO} instead,
     or every request loops.
  4. IIS 10.0 version 1709 or later (Windows Server 2019/2022/2025) for removeServerHeader.
     On Windows Server 2016 remove that attribute, or the site fails with HTTP 500.19.
  5. Feature Delegation (IIS default) lets a site's web.config set httpErrors, staticContent,
     httpProtocol, urlCompression and requestFiltering. If a 500.19 says a section is locked,
     set it to Read/Write under IIS Manager > server > Feature Delegation.

  Main address: https://cware.co.za (no www). Every redirect below goes straight to that
  address, so any old, http:// or www. address reaches its page in one 301 hop.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!-- Rules run top to bottom; each rule stops processing once it fires. -->

        <!-- Repository internals: never serve them and never reveal them through a redirect.
             Request filtering below blocks them too (defence in depth). -->
        <rule name="Block repository internals" stopProcessing="true">
          <match url="^(\.git|\.playwright-mcp|prototype)(/|$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- Certificate renewal (for example win-acme HTTP-01 validation): serve as-is. -->
        <rule name="ACME challenge passthrough" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/" />
          <action type="None" />
        </rule>

        <!-- Old site addresses, from the approved scope document. Each pattern matches with or
             without a trailing slash, in any letter case, and keeps the query string. -->
        <rule name="Legacy /contact-cware" stopProcessing="true">
          <match url="^contact-cware/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/contact/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy /contact-us" stopProcessing="true">
          <match url="^contact-us/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/contact/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy /thank-you-message" stopProcessing="true">
          <match url="^thank-you-message/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/contact/" redirectType="Permanent" />
        </rule>
        <!-- OPEN ISSUE: /privacy-policy -> /privacy-policy/ is in the approved map, but the new site
             has no privacy policy page yet, so this rule is off. Do not redirect to a missing page.
             Once /privacy-policy/index.html exists, the "Add trailing slash to folders" rule already
             sends /privacy-policy to /privacy-policy/, so this rule is optional. If it is enabled,
             keep the pattern without "/?": /privacy-policy/ is the new page itself and must not match.
        <rule name="Legacy /privacy-policy" stopProcessing="true">
          <match url="^privacy-policy$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/privacy-policy/" redirectType="Permanent" />
        </rule>
        -->
        <rule name="Legacy /custom-software" stopProcessing="true">
          <match url="^custom-software/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/services/software-development/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy /software-services" stopProcessing="true">
          <match url="^software-services/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/services/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy /it-services" stopProcessing="true">
          <match url="^it-services/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/services/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy /hire-skilled-developers" stopProcessing="true">
          <match url="^hire-skilled-developers/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/services/team-augmentation/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy /it-staff-augmentation-scale-your-it-team-faster-and-smarter" stopProcessing="true">
          <match url="^it-staff-augmentation-scale-your-it-team-faster-and-smarter/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/services/team-augmentation/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy /ecommerce" stopProcessing="true">
          <match url="^ecommerce/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/products/onlineshop/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy /data-and-analytics" stopProcessing="true">
          <match url="^data-and-analytics/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/services/power-bi/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy /blog" stopProcessing="true">
          <match url="^blog/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/knowledge/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy /best-it-solution" stopProcessing="true">
          <match url="^best-it-solution/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/knowledge/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy /custom-software-key" stopProcessing="true">
          <match url="^custom-software-key/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/services/software-development/" redirectType="Permanent" />
        </rule>
        <!-- PROVISIONAL - confirm: /hosting-solutions -> /services/cloud-integration/ (pending a business decision) -->
        <rule name="Legacy /hosting-solutions" stopProcessing="true">
          <match url="^hosting-solutions/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/services/cloud-integration/" redirectType="Permanent" />
        </rule>
        <!-- PROVISIONAL - confirm: /software-maintenance -> /services/software-development/ (pending a business decision) -->
        <rule name="Legacy /software-maintenance" stopProcessing="true">
          <match url="^software-maintenance/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/services/software-development/" redirectType="Permanent" />
        </rule>
        <!-- PROVISIONAL - confirm: /it-consultation -> /services/software-development/ (pending a business decision) -->
        <rule name="Legacy /it-consultation" stopProcessing="true">
          <match url="^it-consultation/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/services/software-development/" redirectType="Permanent" />
        </rule>
        <!-- PROVISIONAL - confirm: /bi-portal -> /services/power-bi/ (pending a business decision) -->
        <rule name="Legacy /bi-portal" stopProcessing="true">
          <match url="^bi-portal/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/services/power-bi/" redirectType="Permanent" />
        </rule>
        <!-- PROVISIONAL - confirm: /career-opportunities -> /about/ (the scope document says "/careers/ or /about/";
             there is no careers page, so /about/ is used until one exists) -->
        <rule name="Legacy /career-opportunities" stopProcessing="true">
          <match url="^career-opportunities/?$" ignoreCase="true" />
          <action type="Redirect" url="https://cware.co.za/about/" redirectType="Permanent" />
        </rule>

        <!-- Folder addresses without the trailing slash (for example /about, which is also an old
             address) go to the canonical folder URL in one hop, on the main host, over HTTPS.
             IIS would add the slash itself, but on the requested host and scheme, which costs an
             extra hop. All page folders are lowercase, so the target is lowercased. -->
        <rule name="Add trailing slash to folders" stopProcessing="true">
          <match url="^(.*[^/])$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="Redirect" url="https://cware.co.za/{ToLower:{R:1}}/" redirectType="Permanent" />
        </rule>

        <!-- www.cware.co.za (http or https) -> https://cware.co.za, same path and query. -->
        <rule name="Canonical host (no www)" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.cware\.co\.za$" />
          </conditions>
          <action type="Redirect" url="https://cware.co.za{REQUEST_URI}" appendQueryString="false" redirectType="Permanent" />
        </rule>

        <!-- http://cware.co.za -> https://cware.co.za, same path and query. Other host names
             (localhost, the server IP) are left alone so the site can be tested on the server. -->
        <rule name="Canonical protocol (HTTPS)" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^cware\.co\.za$" />
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://cware.co.za{REQUEST_URI}" appendQueryString="false" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <!-- Custom 404 page, sent with a real 404 status. 404.html uses root-relative links
         (/assets/..., /contact/), so it works at any depth. Request-filtering denials
         (404.7, 404.8) also get this page. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <!-- Compression. Static Content Compression must be installed in IIS (see the top).
         Which MIME types are compressed is set server-wide in applicationHost.config
         (system.webServer/httpCompression cannot be set in web.config). text/* and
         application/javascript are compressed by default; add application/json,
         application/xml, application/manifest+json and image/svg+xml there if they are
         missing. woff2 and png are already compressed and need nothing. -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <staticContent>
      <!-- Default for everything outside /assets/ (HTML pages, sitemap.xml, robots.txt):
           "Cache-Control: no-cache", so browsers revalidate every time (304 via ETag /
           Last-Modified) and new wording shows up at once. -->
      <clientCache cacheControlMode="DisableCache" />

      <!-- <remove> first, so an extension IIS already knows does not raise a duplicate-entry error. -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml" />
      <remove fileExtension=".txt" />
      <mimeMap fileExtension=".txt" mimeType="text/plain" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <!-- HSTS for one year on cware.co.za only. includeSubDomains and preload are left out on
             purpose: includeSubDomains would force HTTPS on every subdomain (mail, webmail, any
             internal or third-party host) and break any that are HTTP-only, and preload needs
             includeSubDomains and takes months to undo. Add them only once every subdomain is
             known to serve valid HTTPS. Browsers ignore this header on http:// responses. -->
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- clipboard-write is not disabled: the contact page copies the enquiry brief. -->
        <add name="Permissions-Policy" value="accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" />
        <add name="X-Frame-Options" value="DENY" />
        <!-- Everything is same-origin: /assets/site.css, /assets/site.js, /assets/fonts/*.woff2 and
             images. JSON-LD blocks are data, not executed script, so script-src 'self' does not
             affect them. The pages have no inline style="" attributes, no inline <style> and no
             inline event handlers, so no 'unsafe-inline' is needed. mailto: and https://wa.me/
             links are navigation, which CSP does not restrict. -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'" />
      </customHeaders>
    </httpProtocol>

    <security>
      <!-- removeServerHeader drops "Server: Microsoft-IIS/10.0" (IIS 10.0 1709+). Errors that
           HTTP.sys answers on its own still carry "Microsoft-HTTPAPI/2.0"; set the registry value
           HKLM\SYSTEM\CurrentControlSet\Services\HTTP\Parameters\DisableServerHeader = 2 to hide that. -->
      <requestFiltering removeServerHeader="true">
        <hiddenSegments>
          <remove segment=".git" />
          <add segment=".git" />
          <remove segment="prototype" />
          <add segment="prototype" />
          <remove segment=".playwright-mcp" />
          <add segment=".playwright-mcp" />
        </hiddenSegments>
        <fileExtensions>
          <remove fileExtension=".md" />
          <add fileExtension=".md" allowed="false" />
          <remove fileExtension=".py" />
          <add fileExtension=".py" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

  </system.webServer>

  <!-- /assets/ holds site.css and site.js (cache-busted with ?v=<hash>), fonts and images
       (stable names). Cache for one year and mark immutable. If a font or image in /assets/
       ever changes, give it a new file name (or a ?v= query) or visitors keep the old copy. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- /favicon.ico has a fixed, unversioned address that browsers request on their own:
       cache it for one day. -->
  <location path="favicon.ico">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
